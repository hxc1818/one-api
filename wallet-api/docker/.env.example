# ========================
# 数据库配置
# ========================

# 主数据库连接（必需，与 one-api 共享）
SQL_DSN=root:password@tcp(mysql:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local

# 日志数据库连接（可选，如果不设置则使用主数据库）
# LOG_SQL_DSN=root:password@tcp(mysql:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local

# MySQL 配置（用于 docker-compose）
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=oneapi
# MYSQL_USER=oneapi
# MYSQL_PASSWORD=oneapi123

# ========================
# Redis 配置
# ========================

# Redis 连接字符串（必需）
REDIS_CONN_STRING=redis://redis:6379/0

# Redis 密码（可选）
# REDIS_PASSWORD=your_redis_password

# Redis Stream 配置
REDIS_STREAM_KEY=wallet:balance:updates
REDIS_STREAM_MAXLEN=10000

# ========================
# 应用配置
# ========================

# JWT 密钥（强烈建议修改为随机字符串）
JWT_SECRET=please-change-me-to-random-string-$(openssl rand -hex 32)

# 服务端口
WALLET_API_PORT=8081

# ========================
# 生产环境示例
# ========================

# 如果连接到已有的 one-api 数据库：
# SQL_DSN=root:your_password@tcp(your_host:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local
# REDIS_CONN_STRING=redis://your_redis_host:6379/0
# JWT_SECRET=请使用 openssl rand -hex 32 生成随机密钥
