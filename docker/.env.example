# One-API 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# 时区设置
TZ=Asia/Shanghai

# 数据库配置（三选一）
# SQLite（默认，适合小规模部署）
SQL_DSN=one-api.db

# MySQL
# SQL_DSN=root:your_password@tcp(mysql:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local

# PostgreSQL
# SQL_DSN=postgres://user:your_password@postgres:5432/oneapi?sslmode=disable

# Redis 配置（可选但强烈推荐，用于缓存和速率限制）
REDIS_CONN_STRING=redis://redis:6379

# Session 密钥（建议修改为随机字符串）
SESSION_SECRET=random_secret_key_please_change_this

# 日志级别（debug, info, warn, error）
LOG_LEVEL=info

# 数据库轮询间隔（秒）
POLLING_INTERVAL=60

# 批量更新配置（提升性能）
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5

# 同步频率（秒）
SYNC_FREQUENCY=600

# 节点类型（master 或 slave）
# NODE_TYPE=master

# 初始 Root 用户令牌（首次启动时使用，之后请删除）
# INITIAL_ROOT_TOKEN=your_initial_root_token

# 初始 Root 用户访问令牌（首次启动时使用，之后请删除）
# INITIAL_ROOT_ACCESS_TOKEN=your_initial_access_token

# 主题（default, berry, air）
THEME=default

# 全局 API 速率限制
GLOBAL_API_RATE_LIMIT=480

# 全局 Web 速率限制
GLOBAL_WEB_RATE_LIMIT=240

# 启用指标收集
# ENABLE_METRIC=false

# Relay 超时时间（秒，0 表示不限制）
RELAY_TIMEOUT=0

# Gemini 安全设置
GEMINI_SAFETY_SETTING=BLOCK_NONE

# Gemini 版本
GEMINI_VERSION=v1

# 仅使用单个日志文件
ONLY_ONE_LOG_FILE=false

# Relay 代理
# RELAY_PROXY=http://proxy.example.com:8080

# 用户内容请求代理
# USER_CONTENT_REQUEST_PROXY=http://proxy.example.com:8080

# 用户内容请求超时（秒）
USER_CONTENT_REQUEST_TIMEOUT=30

# 强制包含使用情况
ENFORCE_INCLUDE_USAGE=false

# 测试提示词
TEST_PROMPT=Output only your specific model name with no additional text.
